# ─────────────────────────────────────────────────────────────────────────────
# App (bundled into the app — these are PUBLIC values, never put secrets here)
# Copy to .env.local for local development.
# ─────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The *publishable/anon* key. Row-level security protects data; this key is not a secret.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Where the web pages (claim/open/delete-account) and Android App Links live.
EXPO_PUBLIC_WEB_BASE_URL=https://laterletter.app
# RevenueCat *public* Android SDK key (starts with goog_). Leave empty to hide purchases.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Shown in the app for privacy questions and data requests.
EXPO_PUBLIC_SUPPORT_EMAIL=support@laterletter.app

# Build-time configuration (app.config.ts)
APP_VARIANT=development
# Permanent once uploaded to Google Play!
ANDROID_PACKAGE=app.laterletter.mobile
EAS_PROJECT_ID=
EXPO_OWNER=
# Web build only: Play app-signing SHA-256 fingerprint(s) for /.well-known/assetlinks.json
ANDROID_CERT_SHA256=

# ─────────────────────────────────────────────────────────────────────────────
# Edge Function secrets — create supabase/functions/.env with `npm run secrets:generate`
# (fresh random values), check with `npm run check:env:server -- --production`, upload with
# `npm run deploy:backend`. NEVER commit real values. SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY
# are provided automatically by Supabase in deployed functions.
# ─────────────────────────────────────────────────────────────────────────────
# production = refuse mock email/push, test clock and link logging.
APP_ENV=development
# 32 random bytes, base64. Generate: node -e "console.log('1:'+require('crypto').randomBytes(32).toString('base64'))"
# Back this up somewhere safe: losing it makes every stored letter unreadable.
LETTER_ENCRYPTION_KEYS=1:REPLACE_WITH_BASE64_32_BYTES
# Shared secret for pg_cron → deliver-due. Also store in Vault as 'worker_secret'.
WORKER_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
# Signs one-click email opt-out links.
EMAIL_OPTOUT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
WEB_BASE_URL=https://laterletter.app
# mock = log only, sends nothing (development). resend = real email.
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM="LaterLetter <hello@mail.laterletter.app>"
MOCK_EMAIL_LOG_LINKS=false
# Optional: Expo push access token (if you enabled enhanced push security).
EXPO_ACCESS_TOKEN=
# RevenueCat server-side verification
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH=REPLACE_WITH_LONG_RANDOM_STRING
# Token for GET /functions/v1/health (uptime monitoring).
HEALTH_CHECK_TOKEN=REPLACE_WITH_LONG_RANDOM_STRING
# Development only: lets deliver-due accept {"now": "..."} to demonstrate delivery.
ALLOW_TEST_CLOCK=false
